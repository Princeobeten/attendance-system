# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/attendance
# Secret used to sign the administrator's session cookie (openssl rand -base64 32)
JWT_SECRET=change-me

# Optional: shared key every attendance terminal must present with a tap.
# Leave unset to accept taps from any terminal (fine for local development).
TERMINAL_KEY=

# Show a manual card-UID field on the terminal and registration screens,
# so the system can be demonstrated without an NFC reader.
NEXT_PUBLIC_DEMO_MODE=true

# Time zone used when displaying times (defaults to the server's own).
APP_TIMEZONE=Africa/Lagos
